          ) as sq_two

--39. Restaurant Growth

    with find_daily as
        (select
            visited_on
            , sum(amount) as daily_total
        from Customer
        group by
            visited_on)
    
    , find_rolling_sum as
        (
            select
            visited_on
            , daily_total
            , sum(daily_total) over
                (order by visited_on
                ROWS BETWEEN 6 PRECEDING AND CURRENT ROW
             ) as rolling_seven
        from find_daily)
    
    SELECT
        visited_on
        , rolling_seven as amount
        , round(rolling_seven/7, 2) as average_amount
    FROM find_rolling_sum
    WHERE visited_on >= 
        (select
            DATE_ADD(MIN(visited_on), INTERVAL 6 DAY)
        from find_rolling_sum)
    GROUP BY
        visited_on
        , amount

