--37. Exchange Seats
----//Using modular functions again

      SELECT
          CASE
              WHEN id % 2 = 0 THEN id - 1
              WHEN id =
                  (SELECT
                      MAX(id)
                  FROM Seat) THEN id
              ELSE id + 1
          END AS id
          , student
      FROM Seat
      ORDER BY id ASC

--38. Movie Rating

      SELECT
          results
      FROM (
              SELECT
                  u.name as results
                  , count(mr.movie_id) as count
              FROM MovieRating as mr
                  left join Users as u
                      on mr.user_id = u.user_id
              group by u.name
              ORDER BY 
                  count desc
                  , results asc
              LIMIT 1
          ) as sq_one
      
      UNION ALL
      
      SELECT
          results
      FROM (
          SELECT 
              m.title as results
              , avg(rating) as aver
          FROM MovieRating as mr
              left join Movies as m
                  on mr.movie_id = m.movie_id
          WHERE created_at 
              BETWEEN '2020-02-01' AND '2020-02-29'
          GROUP BY m.title
          ORDER BY
              aver desc
              , results asc
          LIMIT 1
          ) as sq_two

--39. Restaurant Growth

    with find_daily as
        (select
            visited_on
            , sum(amount) as daily_total
        from Customer
        group by
            visited_on)
    
    , find_rolling_sum as
        (
            select
            visited_on
            , daily_total
            , sum(daily_total) over
                (order by visited_on
                ROWS BETWEEN 6 PRECEDING AND CURRENT ROW
             ) as rolling_seven
        from find_daily)
    
    SELECT
        visited_on
        , rolling_seven as amount
        , round(rolling_seven/7, 2) as average_amount
    FROM find_rolling_sum
    WHERE visited_on >= 
        (select
            DATE_ADD(MIN(visited_on), INTERVAL 6 DAY)
        from find_rolling_sum)
    GROUP BY
        visited_on
        , amount
  
