--29. The number of employees which report to each employee

----//Went back to a cte for this one and it was super un-performant

    WITH cte as (
        select
            reports_to as manager_id
            , count(employee_id) as reports_count
            , round(avg(age), 0) as average_age
        from Employees
        group by
            manager_id
    )
    
    select
        e.employee_id
        , e.name
        , cte.reports_count
        , cte.average_age
    from Employees as e
        join cte
            on cte.manager_id = e.employee_id
    WHERE cte.reports_count > 0
        AND cte.reports_count IS NOT NULL
    order by
        employee_id asc

