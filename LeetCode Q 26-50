--27. Biggest Single Number

----//First attempt at subqueries since first learning about them!
----//Logic of mine: return the list of all unique numbers, so that the main query can find the max
----//I read that its possible to put a subquery in any part of the statement so I tried to put it in the having/where, formatted as num = (subquery)
----//But I needed to change the operator to IN to accomodate the list

  select
      max(num) AS num
  from MyNumbers
  where num IN (
      SELECT num 
      FROM MyNumbers
      GROUP BY num
      having count(num) = 1)

