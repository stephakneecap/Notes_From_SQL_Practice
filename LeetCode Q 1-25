--20. 1193. Monthly Transactions I
----//NO DATE TRUNC IN MYSQL had to use dateformat



            select
                date_format(trans_date, '%Y-%m') as month
                , country
                , count(*) as trans_count
                , SUM(CASE when state = 'approved' then 1 else 0 end) as approved_count
                , COALESCE(SUM(amount), 0) as trans_total_amount
                , COALESCE(SUM(CASE when state = 'approved' then amount end), 0) as approved_total_amount
            from transactions
            group by
                month
                , country
;


--21. 1174. Immediate Food Delivery II
----//This one was difficult


            with first_order as(
                select
                    customer_id
                    , min(order_date) as min_order
                    , min(customer_pref_delivery_date) as min_deliv
                from Delivery
                group by
                    customer_id
            )

            select
                round(AVG(CASE when min_order = min_deliv then 1 else 0 end) * 100, 2) as immediate_percentage
            from first_order

            --22. 550. Game Play Analysis IV

            with min as (
                select
                    player_id
                    , min(event_date) as first_day
                from Activity
                group by player_id
            )

            , second as(
                select
                    *
                    , lead(event_date) over (partition by player_id order by event_date) as second_date
                from Activity
            )

            , my_join as(
                select
                    min.player_id
                    , sum(CASE when datediff(second.second_date, min.first_day) = 1 then 1 ELSE 0 END) as players_returned
                from min
                    left join second
                    on min.first_day = second.event_date
                    and min.player_id = second.player_id
                group by
                    min.player_id
            )

            select
                round(avg(players_returned), 2) as fraction
            from my_join


