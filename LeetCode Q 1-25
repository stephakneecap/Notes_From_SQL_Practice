--18. 1633. Percentage of Users Attended a Contest



            with total as(
                select
                    count(user_id) as total_users
                from Users
            )

            select
                contest_id
                , (round(count(distinct r.user_id) / total.total_users, 4)*100) as percentage
            from Register as r
                cross join total
            group by
                contest_id
            order by
                percentage desc
                , contest_id asc

