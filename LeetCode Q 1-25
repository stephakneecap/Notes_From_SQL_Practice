--8. 1581. Customer Who Visited but Did Not Make Any Transactions 


            select 
            v.customer_id
            , sum(IF(t.transaction_id IS NULL, 1, 0)) as count_no_trans
            from visits as v
                left join transactions as t
                    on t.visit_id = v.visit_id
            group by
                v.customer_id
            having count_no_trans > 0
;

--9. 197. Rising Temperature


            WITH cte AS(
                select
                    id
                    , recordDate
                    , temperature
                    , lag(temperature, 1) over (order by recordDate) as mylag
                    , lag(recordDate, 1) over (order by recordDate) as prev_date
                from Weather
            )

            select
            id
            from cte
            where temperature > mylag
                AND Datediff(recordDate, prev_date) = 1


--10. 1661. Average Time of Process per Machine
----//Notes: I could probably do this in less lines, but my brain conceptualized this in terms of the steps it'd take


            WITH start_cte as (
                select
                    machine_id
                    , process_id
                    , timestamp as start_time
                from Activity
                where activity_type = 'start'
                )

            , end_cte as (
                select machine_id
                    , process_id
                    , timestamp as end_time
                from Activity
                where activity_type = 'end'
            )

            , join_cte as (
                select
                s.machine_id
                , e.end_time
                , s.start_time
                , e.end_time - s.start_time as processing
                from start_cte as s
                    join end_cte as e
                        on s.machine_id = e.machine_id
                        and s.process_id = e.process_id
            )

            select
                machine_id
                , round(avg(processing), 3) as processing_time
            from join_cte
            group by
                machine_id
;
