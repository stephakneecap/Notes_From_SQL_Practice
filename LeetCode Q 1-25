--16. 1251. Average Selling Price
----//So with this one, I actually felt tired of using CTEs for so many things and looked up some solutions for alternate
----//ways; I hadn't realized that you're able to put more conditions in the join that aren't strictly join keys



            SELECT 
                p.product_id
                , IFNULL(ROUND(SUM(units*price)/SUM(units),2),0) AS average_price
            FROM Prices as p 
                LEFT JOIN UnitsSold as u
                    ON p.product_id = u.product_id 
                    AND
                        u.purchase_date BETWEEN start_date AND end_date
            group by product_id



