--12. 1280. Students and Examinations



            WITH true_grain as (
                select *
                from Students
                    cross join Subjects
            )
            , agg as (
                select
                    student_id
                    , subject_name
                    , count(*) as attended
                from Examinations
                group by
                    student_id
                    , subject_name
            )

            select
                t.student_id
                , t.student_name
                , t.subject_name
                , COALESCE(a.attended, 0) as attended_exams
            from true_grain as t
                left join agg as a
                    on t.student_id = a.student_id
                        and t.subject_name = a.subject_name
            order by
                student_id
                , subject_name
;


