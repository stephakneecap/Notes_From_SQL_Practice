with sql_symp as 
	(select 
		count(f.event_id) as num_times
		, f.person_id as person_id
		, p.name as name
	from person as p
		join facebook_event_checkin as f 
			on p.id = f.person_id
	where f.event_name like '%SQL Symphony%'
		and f.date between 20171201 and 20171231
	group by f.person_id 
		, p.name
	order by num_times desc)
	
select
	p.name
	, d.height
	, i.annual_income
from person as p
	join sql_symp
		on sql_symp.person_id = p.id
	join drivers_license as d
		on p.license_id = d.id
	join income as i
		on i.ssn = p.ssn
where d.car_make = 'Tesla'
	and d.car_model = 'Model S'
	and d.hair_color = 'red'
	and sql_symp.num_times = 3
